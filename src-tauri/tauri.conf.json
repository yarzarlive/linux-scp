{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinuxSCP",
  "version": "0.1.0",
  "identifier": "com.linuxscp.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LinuxSCP",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "WinSCP-inspired dual-pane file transfer client for the Linux desktop",
    "longDescription": "LinuxSCP is a secure, dual-pane graphical file manager and SSH/SFTP/SCP file transfer client for Linux desktop environments with strict host-key verification, Secret Service integration, and desktop integration.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "openssh-client",
          "libsecret-1-0"
        ],
        "section": "net",
        "priority": "optional"
      }
    }
  }
}

